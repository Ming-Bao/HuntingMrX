    <diagram id="p2" name="Part 2: router, pages and components">
        <mxGraphModel dx="1736" dy="1146" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2-note" value="&lt;b&gt;Part 2: router, pages and components&lt;/b&gt;&lt;br&gt;Every page except HomePage uses currentGame; every page except HomePage and GameOverPage calls api (page 1). LobbyPage listens on /topic/games/{id}, GameBoardPage on the player&#39;s two private channels, both through api.keepUpToDate. GameMap, SidePanel, TicketGrid and MrXLog read game information from currentGame; props carry only the move being built. Props flow down each arrow and events flow back up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;" parent="1" vertex="1"><mxGeometry y="10" width="820" height="80" as="geometry"/></mxCell>
